# Copy to .env.local (git-ignored) and fill in from Supabase → Project Settings → API.

# Public: safe in the browser because Row Level Security protects all data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The "publishable" key (sb_publishable_...) or, on older projects, the anon key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The public URL of the app, used in password-reset and invite links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SECRET — only for local scripts (npm run provision / npm run backup).
# Never add this to Vercel or any NEXT_PUBLIC_ variable; the web app never reads it.
SUPABASE_SERVICE_ROLE_KEY=

# Push notifications (server-only; generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Random secrets: Vercel Cron sends CRON_SECRET; PUSH_DISPATCH_TOKEN is stored in the DB as a SHA-256 hash.
CRON_SECRET=
PUSH_DISPATCH_TOKEN=
